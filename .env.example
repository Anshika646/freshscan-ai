# Public origin URL for OAuth callbacks & self-links
APP_URL="http://localhost:3000"

# Express gateway port (Cloud Run injects PORT=8080 in production)
PORT="3000"

# Internal Python FastAPI TensorFlow inference service port
ML_PORT="8050"

# Comma-separated allowed CORS origins for standalone FastAPI deployment ("*" for local dev)
CORS_ORIGINS="*"

# Maximum accepted image upload size in megabytes
MAX_UPLOAD_MB="15"

# Optional GitHub OAuth App credentials for browser-based repository sync to FreshScan-AI
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Reserved runtime environment variable
GEMINI_API_KEY=""
